# Jev (TypeSafe System One). Either name works.
JEV_API_KEY=
# TYPESAFE_API_KEY=

# ntfy topic for push notifications. Pick something long and random: anyone who knows it can read your nudges.
NTFY_TOPIC=

# Optional tuning
# NUDGE_MIN_AGE_MIN=120   # minutes before an unanswered message counts (0 for a live demo)
# NUDGE_WINDOW_DAYS=180   # quiet chats this recent are still checked for open loops
# NUDGE_KEEP=50           # recent messages kept per chat in nudge.db
# NUDGE_DB=               # path to the bridge's messages.db (default: vendor/.../store/messages.db)
# NUDGE_STORE=            # path to Nudge's own database (default: ./nudge.db)

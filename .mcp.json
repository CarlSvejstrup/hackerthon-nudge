{
  "mcpServers": {
    "whatsapp": {
      "command": "uv",
      "args": ["--directory", "vendor/whatsapp-mcp/whatsapp-mcp-server", "run", "main.py"]
    },
    "nudge": {
      "command": "uv",
      "args": ["run", "-q", "python", "-m", "nudge.mcp_server"],
      "env": { "NUDGE_MIN_AGE_MIN": "0" }
    }
  }
}
